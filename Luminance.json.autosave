'Game Scene');","await harness.stepFrames(3);","const probe = await harness.resetSceneAndProbeControls('Player', ['d', 'a', 'w', 's']);","const rightKey = 'd';","harness.assert(probe.keys.d && probe.keys.d.dx > 5, 'd moves the player right');","","// Regime A: huge dead zone -> focus must NOT follow the player.","harness.setSceneVariable('CameraDeadZone', 100000);","let p0 = harness.getObjects('Player')[0];","let c0 = harness.getObjects('CameraFocus')[0];","harness.setKeyPressed(rightKey, true);","await harness.stepUntil(() => harness.getObjects('Player')[0].x > p0.x + 300, { maxFrames: 600 });","harness.setKeyPressed(rightKey, false);","await harness.stepFrames(5);","let c1 = harness.getObjects('CameraFocus')[0];","harness.assert(Math.abs(c1.x - c0.x) < 5, 'Huge dead zone: camera focus does not follow');","","// Regime B: zero dead zone -> focus follows the player closely.","await harness.goToScene('Game Scene');","await harness.stepFrames(3);","harness.setSceneVariable('CameraDeadZone', 0);","p0 = harness.getObjects('Player')[0];","c0 = harness.getObjects('CameraFocus')[0];","harness.setKeyPressed(rightKey, true);","await harness.stepUntil(() => harness.getObjects('Player')[0].x > p0.x + 300, { maxFrames: 600 });","harness.setKeyPressed(rightKey, false);","await harness.stepFrames(5);","let c2 = harness.getObjects('CameraFocus')[0];","const focusMove = c2.x - c0.x;","const playerMove = harness.getObjects('Player')[0].x - p0.x;","harness.assert(focusMove > playerMove * 0.5, 'Zero dead zone: camera focus follows the player');"]},{"description":"9-key toggles the hitbox overlay, which stays centered on the player.","lastRunAt":1786584813890.0,"lastRunDurationMs":793.0,"lastRunFramesExecuted":14,"lastRunStatus":"passed","name":"Hitbox toggle and centered dead zone","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(5);","const player = harness.getObjects('Player')[0];","// 9 toggles the hitbox on, centered on the player.","harness.setKeyPressed('Num9', true);","await harness.stepFrames(2);","harness.setKeyPressed('Num9', false);","await harness.stepFrames(2);","let hb = harness.getObjects('PlayerHitbox')[0];","harness.assert(harness.getSceneVariable('ShowHitbox').value === true, 'ShowHitbox true on 9');","harness.assert(hb.hidden === false, 'PlayerHitbox shown');","harness.assert(Math.abs(hb.x - (player.centerX - hb.width / 2)) < 25, 'Hitbox centered on player x');","harness.assert(Math.abs(hb.y - (player.centerY - hb.height / 2)) < 25, 'Hitbox centered on player y');","// 9 toggles the hitbox off.","harness.setKeyPressed('Num9', true);","await harness.stepFrames(2);","harness.setKeyPressed('Num9', false);","await harness.stepFrames(2);","hb = harness.getObjects('PlayerHitbox')[0];","harness.assert(hb.hidden === true, 'PlayerHitbox hidden on second 9');"]},{"description":"Player FacingAngle tracks the mouse cursor direction.","lastRunAt":1786584446574.0,"lastRunDurationMs":845.0,"lastRunFramesExecuted":17,"lastRunStatus":"passed","name":"Mouse facing angle","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(10);","const pid = harness.getObjects('Player')[0].id;","// Mouse far right -> player faces East (positive world X).","harness.setMousePositionScreen(1200, 360);","await harness.stepFrames(3);","const right = harness.getObjectVariable(pid, 'FacingAngle').value;","// Mouse far left -> player faces West (negative world X).","harness.setMousePositionScreen(80, 360);","await harness.stepFrames(3);","const left = harness.getObjectVariable(pid, 'FacingAngle').value;","harness.assert(right > 45 && right < 135, 'Facing points East when mouse is right');","harness.assert(left < -45 && left > -135, 'Facing points West when mouse is left');","harness.assert(right > left, 'Facing angle follows the mouse left/right');"]},{"description":"Left-click starts an attack, the player stops during it, and movement resumes after it ends.","lastRunAt":1786661593847.0,"lastRunDurationMs":0.0,"lastRunFramesExecuted":0,"lastRunStatus":"error","name":"Left click attacks and stops movement","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(5);","","harness.setKeyPressed('d', true);","await harness.stepFrames(15);","","harness.setMousePosition(640, 360);","harness.setMouseButtonPressed(true, 'left');","await harness.stepFrames(1);","harness.setMouseButtonPressed(false, 'left');","","let sawAttack = false;","let attackFrames = 0;","let movedDuring = 0;","let movedAfter = 0;","let ended = false;","","for (let i = 0; i < 120; i++) {","  const p = harness.getObjects('Player')[0];","  const x = p.x, z = p.z || 0;","  const atk = (p.animation || '').includes('Attack');","  if (atk) sawAttack = true;","  await harness.stepFrames(1);","  const q = harness.getObjects('Player')[0];","  if (atk) {","    attackFrames++;","    movedDuring += Math.abs(q.x - x) + Math.abs((q.z || 0) - z);","  } else if (sawAttack) {","    ended = true;","    movedAfter += Math.abs(q.x - x) + Math.abs((q.z || 0) - z);","  }","}","","harness.assert(sawAttack, 'Attack animation played after left click (' + attackFrames + ' frames)');","harness.assert(movedDuring < 5, 'No movement during attack (moved=' + movedDuring.toFixed(1) + ')');","harness.assert(ended, 'Attack animation ended');","harness.assert(movedAfter > 10, 'Movement resumes after attack (moved=' + movedAfter.toFixed(1) + ')');","harness.releaseAllInputs();"]},{"description":"Health bar value and max match the Player's Health behavior, and update when the player takes damage.","lastRunAt":1787187224065.0,"lastRunDurationMs":1244.0,"lastRunFramesExecuted":5,"lastRunStatus":"passed","name":"Health bar syncs with player health","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(3);","","const player = harness.getObjects('Player')[0];","const bar = harness.getObjects('Health')[0];","harness.assert(player && bar, 'Player and Health bar exist');","","const healthState = player.behaviors.Health.state;","const healthBhv = harness.getRuntimeObject(player.id).getBehavior('Health');","console.log(JSON.stringify({healthMethods:Object.getOwnPropertyNames(Object.getPrototypeOf(healthBhv)), ownMethods:Object.keys(healthBhv)}));","console.log(JSON.stringify({barState:bar.state,barVariables:bar.variables}));","","harness.assert(healthState.Health === 5, 'Player starts at full health (5), got ' + healthState.Health);","harness.assert(bar.state.Value === healthState.Health, 'Bar value equals player health (' + bar.state.Value + ' vs ' + healthState.Health + ')');","harness.assert(bar.state.MaxValue === healthState.MaxHealth, 'Bar max equals player max (' + bar.state.MaxValue + ' vs ' + healthState.MaxHealth + ')');","","await harness.stepFrames(1);"]},{"description":"HealthBar shows sprite (9 - health): full health -> sprite 1, zero -> sprite 9.","lastRunAt":1787189341018.0,"lastRunDurationMs":895.0,"lastRunFramesExecuted":6,"lastRunStatus":"failed","name":"HealthBar reversed sprite mapping","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(3);","","const player = harness.getObjects('Player')[0];","const bar = harness.getObjects('HealthBar')[0];","harness.assert(player && bar, 'Player and HealthBar exist');","","const playerObj = harness.getRuntimeObject(player.id);","const healthBhv = playerObj.getBehavior('Health');","harness.assert(healthBhv._getMaxHealth() === 8, 'Player max health is 8, got ' + healthBhv._getMaxHealth());","","// Full health (8) -> sprite 1","healthBhv._setHealth(8);","await harness.stepFrames(2);","let barObj = harness.getRuntimeObject(bar.id);","let animName = barObj.getAnimationName();","harness.assert(animName === '1', 'Health 8 shows sprite 1, got \"' + animName + '\"');","","// Zero health -> sprite 9","healthBhv._setHealth(0);","await harness.stepFrames(2);","barObj = harness.getRuntimeObject(bar.id);","animName = barObj.getAnimationName();","harness.assert(animName === '9', 'Health 0 shows sprite 9, got \"' + animName + '\"');","","// Mid health (4) -> sprite 5","healthBhv._setHealth(4);","await harness.stepFrames(2);","barObj = harness.getRuntimeObject(bar.id);","animName = barObj.getAnimationName();","harness.assert(animName === '5', 'Health 4 shows sprite 5, got \"' + animName + '\"');"]},{"description":"Fix sync object positioning so the stored enemy behavior test executes.","lastRunAt":1787470641046.0,"lastRunDurationMs":1242.0,"lastRunFramesExecuted":60,"lastRunStatus":"failed","name":"Enemy full behavior","type":"gameplay","source":["await harness.goToScene('Game Scene');","const p = harness.getObjects('Player')[0];","let e = harness.getObjects('Enemy')[0];","// 1. Enemy moves toward player","const d0 = Math.hypot(p.centerX - e.centerX, p.centerY - e.centerY);","const moved = await harness.stepUntil(() => {","  const en = harness.getObjects('Enemy')[0];","  const pl = harness.getObjects('Player')[0];","  return Math.hypot(pl.centerX - en.centerX, pl.centerY - en.centerY) < d0 - 40;","}, { maxFrames: 300 });","harness.assert(moved, 'Enemy moves toward player');","// 2. Enemy faces the direction it moves (points toward player)","const en = harness.getObjects('Enemy')[0];","const pl = harness.getObjects('Player')[0];","const facing = en.variables.find(v => v.name === 'FacingDirection')?.value;","const dx = pl.centerX - en.centerX, dy = pl.centerY - en.centerY;","const expected = Math.abs(dx) >= Math.abs(dy) ? (dx >= 0 ? 'East' : 'West') : (dy >= 0 ? 'South' : 'North');","harness.assert(facing === expected, `Enemy faces ${expected} (got ${facing})`);","// 3. Enemy damages player when within range and attacking","harness.setObjectPosition(e.id, p.x + 60, p.y + 60);","await harness.stepFrames(40);","const pHealth = harness.getObjects('Player')[0].variables.find(v => v.name === 'Health').value;","harness.assert(pHealth < 8, `Enemy damaged player (player health=${pHealth})`);","// 4. Enemy dies after 3 player hits","for (let i = 0; i < 3; i++) {","  harness.setMouseButtonPressed(true, 'left');","  await harness.stepFrames(1);","  harness.setMouseButtonPressed(false, 'left');","  await harness.stepUntil(() => {","    const pll = harness.getObjects('Player')[0];","    return pll.variables.find(v => v.name === 'IsAttacking')?.value === false;","  }, { maxFrames: 120 });","}","await harness.stepFrames(5);","const enemies = harness.getObjects('Enemy');","harness.assert(enemies.length === 0, 'Enemy dies after 3 hits (remaining: ' + enemies.length + ')');"]},{"description":"","lastRunAt":1787469873715.0,"lastRunDurationMs":493.0,"lastRunFramesExecuted":0,"lastRunStatus":"error","name":"Hitboxes narrowed 50% horizontally and centered","type":"gameplay","source":""},{"description":"Enemy spawns and stays on screen; player hitbox half width centered; enemy physics shape scaled 0.5.","lastRunAt":1787470536898.0,"lastRunDurationMs":0.0,"lastRunFramesExecuted":0,"lastRunStatus":"error","name":"Hitboxes narrowed and enemy spawns","type":"gameplay","source":["await harness.goToScene('Game Scene', {skipCreatingInstances: true});","await harness.stepFrames(1);","const player = harness.getObjects('Player')[0];","const hitbox = harness.getObjects('PlayerHitbox')[0];","const enemy = harness.getObjects('Enemy')[0];","harness.assert(!!player && !!hitbox, 'Player and PlayerHitbox exist');","harness.assert(!!enemy, 'Enemy exists and spawns');","if (player && hitbox) {","  harness.assert(Math.abs(hitbox.width - player.width / 2) < 1, 'PlayerHitbox width is half the player width (got ' + hitbox.width + ' vs ' + player.width + ')');","  harness.assert(Math.abs(hitbox.centerX - player.centerX) < 1, 'PlayerHitbox centered on player (hitbox center ' + hitbox.centerX + ' vs player center ' + player.centerX + ')');","}","if (enemy) {","  harness.assert(enemy.x > 500 && enemy.x < 1300, 'Enemy stays on screen (x=' + enemy.x + ')');","  const physics = enemy.behaviors && enemy.behaviors.Physics3D;","  const shapeScale = physics && physics.state ? physics.state.ShapeScale : undefined;","  harness.assert(shapeScale === undefined || Math.abs(shapeScale - 0.5) < 0.01, 'Enemy physics shape scale is 0.5 (got ' + shapeScale + ')');","}"]},{"description":"Verify enemy swarms spawn each phase, phase counter increments, and phase-2 enemies spawn with increased speed.","lastRunAt":1787563875841.0,"lastRunDurationMs":740.0,"lastRunFramesExecuted":6,"lastRunStatus":"failed","name":"Enemy swarm phases spawn and scale","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(5);","","const enemiesPhase1 = harness.getObjects('Enemy');","harness.assert(enemiesPhase1.length >= 4, 'Phase 1 spawned at least 4 enemies (got ' + enemiesPhase1.length + ')');","const phase = harness.getSceneVariable('Phase');","harness.assert(phase && phase.value === 1, 'Phase is 1 (got ' + JSON.stringify(phase) + ')');","const phaseText = harness.getObjects('PhaseText')[0];","harness.assert(phaseText && phaseText.text.indexOf('Phase: 1') !== -1, 'PhaseText shows Phase: 1');","","// Step ~61 seconds to trigger phase 2","await harness.stepFrames(60, {dtMs: 1000});","const phase2 = harness.getSceneVariable('Phase');","harness.assert(phase2 && phase2.value === 2, 'Phase advanced to 2 after 60s (got ' + JSON.stringify(phase2) + ')');","const enemiesPhase2 = harness.getObjects('Enemy');","harness.assert(enemiesPhase2.length >= 5, 'Phase 2 spawned more enemies (got ' + enemiesPhase2.length + ')');","const phase2Text = harness.getObjects('PhaseText')[0];","harness.assert(phase2Text && phase2Text.text.indexOf('Phase: 2') !== -1, 'PhaseText shows Phase: 2');","","// Newly spawned phase-2 enemies should have Speed 165. Check the max speed among enemies.","const speeds = enemiesPhase2.map(e => { const s = e.variables.find(v => v.name === 'Speed'); return s ? s.value : 0; });","const maxSpeed = Math.max(...speeds);","harness.assert(Math.abs(maxSpeed - 165) < 1, 'Phase 2 spawns enemies with speed 165 (max speed was ' + maxSpeed + ')');"]},{"description":"Player Z stays at 52 every frame, including during an attack.","lastRunAt":1787563503280.0,"lastRunDurationMs":0.0,"lastRunFramesExecuted":0,"lastRunStatus":"error","name":"Player Z locked at 52","type":"gameplay","source":["await harness.goToScene('Game Scene');","let ok = true;","let minZ = Infinity, maxZ = -Infinity;","await harness.stepFrames(30, { onFrame: () => {","  const p = harness.getObjects('Player')[0];","  const z = p.z;","  if (z < minZ) minZ = z;","  if (z > maxZ) maxZ = z;","  if (Math.abs(z - 52) > 0.01) ok = false;","}});","// trigger an attack","harness.setMouseButtonPressed(true, 'left');","await harness.stepFrames(1);","harness.setMouseButtonPressed(false, 'left');","await harness.stepFrames(40, { onFrame: () => {","  const p = harness.getObjects('Player')[0];","  const z = p.z;","  if (z < minZ) minZ = z;","  if (z > maxZ) maxZ = z;","  if (Math.abs(z - 52) > 0.01) ok = false;","}});","harness.assert(ok, `Player Z stayed at 52 (min=${minZ}, max=${maxZ})`);"]},{"description":"Phase 1 spawns exactly 3 enemies at speed 120, and a hit knocks the enemy directly away from the player.","lastRunAt":1787534771704.0,"lastRunDurationMs":1169.0,"lastRunFramesExecuted":38,"lastRunStatus":"passed","name":"Phase1 count, launch speed and knockback direction","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(10);","","// Phase 1 must spawn exactly 3 enemies at the lowered launch speed of 120.","const enemies = harness.getObjects('Enemy');","harness.assert(enemies.length === 3, 'Phase 1 spawns exactly 3 enemies, got ' + enemies.length);","for (const e of enemies) {","  const sp = (e.variables || []).find(v => v.name === 'Speed' || v.variableName === 'Speed');","  const val = sp ? Number(sp.value) : NaN;","  harness.assert(val === 120, 'Spawned enemy Speed is 120, got ' + val);","}","","// Knockback consistency: spawn a fresh enemy just east of the player.","// spawn() sets the ORIGIN (corner), so offset by half size to land the CENTER 100px east.","const p = harness.getObjects('Player')[0];","const target = harness.spawn('Enemy', p.centerX + 100 - 153.6 / 2, p.centerY - 153.6 / 2, 51);","await harness.stepFrames(2);","const placed = harness.getObjects('Enemy').find(o => o.id === target.id);","harness.assert(placed && Math.hypot(placed.centerX - p.centerX, placed.centerY - p.centerY) < 125,","  'Test enemy sits within hit range of the player');","","// Aim the mouse along the player->enemy-center direction (FacingAngle follows the cursor).","const dx = placed.centerX - p.centerX, dy = placed.centerY - p.centerY;","harness.setMousePosition(p.centerX + 3 * dx, p.centerY - 3 * dy);","await harness.stepFrames(2);","const aimed = harness.getObjectVariable('Player', 'FacingAngle');","harness.assert(aimed && Math.abs(Number(aimed.value)) < 25 || aimed && Math.abs(Number(aimed.value) - 90) < 25,","  'Player faces toward the test enemy, got ' + (aimed && aimed.value));","","harness.setMouseButtonPressed(true, 'left');","await harness.stepFrames(1);","harness.setMouseButtonPressed(false, 'left');","await harness.stepFrames(2);","","let eHit = harness.getObjects('Enemy').find(o => o.id === target.id);","const knockedVar = (eHit.variables || []).find(v => (v.name || v.variableName) === 'Knocked');","harness.assert(knockedVar && knockedVar.value === true, 'Enemy is flagged Knocked after being hit');","","const distFrom = (e) => Math.hypot(e.centerX - p.centerX, e.centerY - p.centerY);","const d0 = distFrom(eHit);","await harness.stepFrames(20);","eHit = harness.getObjects('Enemy').find(o => o.id === target.id);","const d1 = distFrom(eHit);","harness.assert(d1 > d0 + 10, 'Knocked enemy moved AWAY from player (distance ' + d0.toFixed(1) + ' -> ' + d1.toFixed(1) + ')');",""]},{"description":"Fix stored test execution with minimal source change.","lastRunAt":1787563683283.0,"lastRunDurationMs":0.0,"lastRunFramesExecuted":0,"lastRunStatus":"error","name":"Player and camera Z locked at 52","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(10);","for (let i = 0; i < 12; i++) {","  await harness.stepFrames(5);","  const p = harness.getObjects('Player')[0];","  const f = harness.getObjects('CameraFocus')[0];","  harness.assert(Math.abs(p.centerZ - 52) < 0.01, 'frame ' + i + ': Player Z locked at 52, got ' + p.centerZ);","  harness.assert(Math.abs(f.centerZ - 52) < 0.01, 'frame ' + i + ': CameraFocus centerZ locked at 52, got ' + f.centerZ);","}","const p = harness.getObjects('Player')[0];","harness.setMousePosition(p.centerX + 300, p.centerY);","await harness.stepFrames(2);","harness.setMouseButtonPressed(true, 'left');","await harness.stepFrames(1);","harness.setMouseButtonPressed(false, 'left');","const attacking = harness.getObjectVariable('Player', 'IsAttacking');","harness.assert(attacking && attacking.value === true, 'Attack started');","for (let i = 0; i < 12; i++) {","  await harness.stepFrames(5);","  const pNow = harness.getObjects('Player')[0];","  const fNow = harness.getObjects('CameraFocus')[0];","  harness.assert(Math.abs(pNow.centerZ - 52) < 0.01, 'attack frame ' + i + ': Player Z locked at 52, got ' + pNow.centerZ);","  harness.assert(Math.abs(fNow.centerZ - 52) < 0.01, 'attack frame ' + i + ': CameraFocus centerZ locked at 52, got ' + fNow.centerZ);","}"]},{"description":"Enemy speed is capped, each enemy has a random SpeedMult, and close enemies separate instead of stacking.","lastRunAt":1787564017967.0,"lastRunDurationMs":3024.0,"lastRunFramesExecuted":11,"lastRunStatus":"failed","name":"Enemy speed cap, variation and separation","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(10);","","const enemies = harness.getObjects('Enemy');","harness.assert(enemies.length === 3, 'Phase 1 spawns 3 enemies, got ' + enemies.length);","for (const e of enemies) {","  const sp = (e.variables || []).find(v => (v.name || v.variableName) === 'Speed');","  const mult = (e.variables || []).find(v => (v.name || v.variableName) === 'SpeedMult');","  harness.assert(Number(sp.value) <= 250, 'Enemy Speed capped at 250, got ' + sp.value);","  harness.assert(Number(mult.value) >= 0.8 && Number(mult.value) <= 1.2,","    'Enemy SpeedMult in [0.8,1.2], got ' + mult.value);","}","","const p = harness.getObjects('Player')[0];","const a = harness.spawn('Enemy', p.centerX + 100, p.centerY, 51);","const b = harness.spawn('Enemy', p.centerX + 130, p.centerY, 51);","await harness.stepFrames(3);","let ea = harness.getObjects('Enemy').find(o => o.id === a.id);","let eb = harness.getObjects('Enemy').find(o => o.id === b.id);","const d0 = Math.hypot(ea.centerX - eb.centerX, ea.centerY - eb.centerY);","await harness.stepFrames(40);","ea = harness.getObjects('Enemy').find(o => o.id === a.id);","eb = harness.getObjects('Enemy').find(o => o.id === b.id);","const d1 = Math.hypot(ea.centerX - eb.centerX, ea.centerY - eb.centerY);","harness.assert(d1 > d0, 'Two close enemies separated over time (dist ' + d0.toFixed(1) + ' -> ' + d1.toFixed(1) + ')');",""]},{"description":"Enemy speed stays constant at its starting value, and total enemies never exceed 17.","lastRunAt":1787564541877.0,"lastRunDurationMs":6705.0,"lastRunFramesExecuted":2011,"lastRunStatus":"failed","name":"Constant enemy speed and 17-enemy cap","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(10);","","// 1) Every enemy's Speed stays at its starting value and never varies per-enemy.","const enemies = harness.getObjects('Enemy');","harness.assert(enemies.length === 3, 'Phase 1 spawns 3 enemies, got ' + enemies.length);","const startingIds = enemies.map(e => e.id);","let prevSpeed = null;","for (const e of enemies) {","  const sp = harness.getObjectVariable(e.id, 'Speed');","  const val = Number(sp?.value);","  harness.assert(val === 120, 'Enemy Speed equals starting 120, got ' + val);","  if (prevSpeed === null) prevSpeed = val;","  else harness.assert(val === prevSpeed, 'All enemies share the same speed (no per-enemy variation)');","}","","for (const id of startingIds) {","  const sp = harness.getObjectVariable(id, 'Speed');","  harness.assert(Number(sp?.value) === 120, 'Enemy Speed stays constant at 120, got ' + sp?.value);","}","","// Confirm the chase uses Enemy.Speed directly (constant), and cap total at 17.","const reachedPhase4 = await harness.stepFrames(2000, {dtMs: 100});","harness.assert((harness.getSceneVariable('Phase')?.value ?? 0) >= 4, 'Phase 4 was reached to exercise the enemy cap');","const countNow = harness.getObjects('Enemy').length;","harness.assert(countNow <= 17, 'Total enemies capped at 17, got ' + countNow);",""]},{"description":"Attack range is halved to 80, and the hit animation freezes the enemy (no move, no attack) until it finishes.","lastRunAt":1787566521984.0,"lastRunDurationMs":4799.0,"lastRunFramesExecuted":23,"lastRunStatus":"failed","name":"Halved attack range and hit-stun override","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(1);","","// Attack range halved: EnemyContactDist is now 80 (was 160).","const range = harness.getSceneVariable('EnemyContactDist');","harness.assert(Number(range.value) === 80, 'Attack range halved to 80, got ' + range.value);","","// An enemy at ~120px (between old 160 and new 80) must NOT start attacking.","const p = harness.getObjects('Player')[0];","const far = harness.spawn('Enemy', p.centerX + 120, p.centerY, 51);","await harness.stepFrames(5);","let eFar = harness.getObjects('Enemy').find(o => o.id === far.id);","let attFar = (eFar.variables || []).find(v => (v.name || v.variableName) === 'IsAttacking');","harness.assert(attFar.value === false, 'Enemy at 120px does not attack (range halved), IsAttacking=' + attFar.value);","","// Hit-stun override: spawn enemy whose CENTER lands ~100px east (corner offset by half width).","const close = harness.spawn('Enemy', p.centerX + 100 - 153.6 / 2, p.centerY - 153.6 / 2, 51);","await harness.stepFrames(2);","let eClose = harness.getObjects('Enemy').find(o => o.id === close.id);","const cdx = eClose.centerX - p.centerX, cdy = eClose.centerY - p.centerY;","harness.assert(Math.hypot(cdx, cdy) < 125, 'Test enemy within hit range');","harness.setMousePosition(p.centerX + 4 * cdx, p.centerY - 4 * cdy);","await harness.stepFrames(2);","harness.setMouseButtonPressed(true, 'left');","await harness.stepFrames(1);","harness.setMouseButtonPressed(false, 'left');","await harness.stepFrames(1);","eClose = harness.getObjects('Enemy').find(o => o.id === close.id);","let hitVar = (eClose.variables || []).find(v => (v.name || v.variableName) === 'Hit');","harness.assert(hitVar.value === true, 'Enemy is in hit animation (Hit=true)');","let attNow = (eClose.variables || []).find(v => (v.name || v.variableName) === 'IsAttacking');","harness.assert(attNow.value === false, 'Hit cancelled any attack (IsAttacking=false)');","","const hx = eClose.centerX, hy = eClose.centerY;","await harness.stepFrames(10);","eClose = harness.getObjects('Enemy').find(o => o.id === close.id);","if (eClose) {","  const moved = Math.hypot(eClose.centerX - hx, eClose.centerY - hy);","  const stillHit = (eClose.variables || []).find(v => (v.name || v.variableName) === 'Hit').value;","  if (stillHit) harness.assert(moved < 2, 'Enemy does not move during hit animation (moved ' + moved.toFixed(1) + 'px)');","}",""]},{"description":"Attack range increased to 96, enemy stands still while attacking, and the direction hit cone widened to 21 degrees.","lastRunAt":1787566729185.0,"lastRunDurationMs":1471.0,"lastRunFramesExecuted":32,"lastRunStatus":"passed","name":"Enemy attack range, stand-still and direction angle","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(10);","","// 1) Attack range increased 20%: EnemyContactDist is now 96 (was 80).","const range = harness.getSceneVariable('EnemyContactDist');","harness.assert(Number(range.value) === 96, 'Attack range increased to 96, got ' + range.value);","","// 2) Enemy stands still while attacking: put an enemy within range so it attacks,","//    and confirm it does not move.","const p = harness.getObjects('Player')[0];","// spawn so center lands ~60px away (within 96 range, corner-offset for a 153.6 enemy).","const atk = harness.spawn('Enemy', p.centerX + 60 - 153.6 / 2, p.centerY - 153.6 / 2, 51);","await harness.stepFrames(5);","let e = harness.getObjects('Enemy').find(o => o.id === atk.id);","let attacking = (e.variables || []).find(v => (v.name || v.variableName) === 'IsAttacking');","harness.assert(attacking.value === true, 'Enemy within range starts attacking');","const ax = e.centerX, ay = e.centerY;","await harness.stepFrames(10);","e = harness.getObjects('Enemy').find(o => o.id === atk.id);","const moved = Math.hypot(e.centerX - ax, e.centerY - ay);","harness.assert(moved < 3, 'Enemy stands still while attacking (moved ' + moved.toFixed(2) + 'px)');","","// 3) Direction angle increased 20%: hit cone is now 21 degrees. Hit an enemy just","//    at the wider cone edge to confirm the larger angle registers.","const hit = harness.spawn('Enemy', p.centerX + 70 - 153.6 / 2, p.centerY - 153.6 / 2, 51);","await harness.stepFrames(2);","let eHit = harness.getObjects('Enemy').find(o => o.id === hit.id);","const hdx = eHit.centerX - p.centerX, hdy = eHit.centerY - p.centerY;","harness.assert(Math.hypot(hdx, hdy) < 125, 'Test enemy within 125 hit range');","// Aim with a ~20-degree offset to validate the widened cone.","const ang = Math.atan2(hdy, hdx) * 180 / Math.PI;","const aimAng = ang + 20;","const aimX = p.centerX + Math.cos(aimAng * Math.PI / 180) * 300;","const aimY = p.centerY - Math.sin(aimAng * Math.PI / 180) * 300;","harness.setMousePosition(aimX, aimY);","await harness.stepFrames(2);","harness.setMouseButtonPressed(true, 'left');","await harness.stepFrames(1);","harness.setMouseButtonPressed(false, 'left');","await harness.stepFrames(1);","eHit = harness.getObjects('Enemy').find(o => o.id === hit.id);","const hitVar = (eHit.variables || []).find(v => (v.name || v.variableName) === 'Hit');","harness.assert(hitVar.value === true, 'Enemy hit at 20-degree offset (wider cone registers)');",""]},{"description":"Enemy finishes its attack animation (standing still) before resuming to follow the player.","lastRunAt":1787567076586.0,"lastRunDurationMs":1772.0,"lastRunFramesExecuted":94,"lastRunStatus":"passed","name":"Enemy finishes attack before following","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(10);","","const p = harness.getObjects('Player')[0];","","// Place an enemy whose center lands within attack range (96).","const atk = harness.spawn('Enemy', p.centerX + 60 - 153.6 / 2, p.centerY - 153.6 / 2, 51);","await harness.stepFrames(5);","let e = harness.getObjects('Enemy').find(o => o.id === atk.id);","let att = (e.variables || []).find(v => (v.name || v.variableName) === 'IsAttacking');","harness.assert(att.value === true, 'Enemy within range is attacking');","","// Move the player far away so the enemy leaves attack range; it must FINISH its","// attack animation before resuming the follow. During the attack it must stand still.","const ax = e.centerX, ay = e.centerY;","await harness.stepFrames(8);","e = harness.getObjects('Enemy').find(o => o.id === atk.id);","let moved = Math.hypot(e.centerX - ax, e.centerY - ay);","harness.assert(moved < 3, 'Enemy stands still while finishing attack (moved ' + moved.toFixed(2) + 'px)');","","// Teleport the player far away so the enemy clears range.","const far = harness.getObjects('Player')[0];","harness.setObjectPosition(far.id, far.x + 900, far.y);","","// Over time, after the attack animation ends, the enemy must resume following (Moving=true).","let resumed = false;","for (let i = 0; i < 40; i++) {","  await harness.stepFrames(5);","  const en = harness.getObjects('Enemy').find(o => o.id === atk.id);","  if (!en) { resumed = false; break; }","  const mv = (en.variables || []).find(v => (v.name || v.variableName) === 'Moving');","  if (mv && mv.value === true) { resumed = true; break; }","}","harness.assert(resumed, 'Enemy resumed following after finishing its attack animation');"]},{"description":"Enemy chases the player directly after removing separation logic.","lastRunAt":1787567326429.0,"lastRunDurationMs":1299.0,"lastRunFramesExecuted":56,"lastRunStatus":"passed","name":"Enemy chases without separation","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(10);","","const p = harness.getObjects('Player')[0];","// Spawn an enemy far from the player so it must chase.","const e0 = harness.spawn('Enemy', p.centerX - 153.6 / 2 - 400, p.centerY - 153.6 / 2, 51);","await harness.stepFrames(5);","let e = harness.getObjects('Enemy').find(o => o.id === e0.id);","const d0 = Math.hypot(e.centerX - p.centerX, e.centerY - p.centerY);","await harness.stepFrames(40);","e = harness.getObjects('Enemy').find(o => o.id === e0.id);","const d1 = Math.hypot(e.centerX - p.centerX, e.centerY - p.centerY);","const mv = (e.variables || []).find(v => (v.name || v.variableName) === 'Moving');","harness.assert(mv.value === true, 'Enemy is moving (chasing)');","harness.assert(d1 < d0, 'Enemy approached the player (distance ' + d0.toFixed(1) + ' -> ' + d1.toFixed(1) + ')');",""]},{"description":"Verify enemies no longer zip at launch and Z stays stable at 52.","lastRunAt":1787567828342.0,"lastRunDurationMs":1535.0,"lastRunFramesExecuted":41,"lastRunStatus":"failed","name":"Enemy launch zipping fix","type":"gameplay","source":["await harness.goToScene('Game Scene');","// Sample every frame from launch for 40 frames, flag any spike over 250 px/s.","let worst = 0, worstFrame = -1, spikes = 0;","let prev = {};","let zJitter = 0;","for (let f = 0; f < 40; f++) {","  await harness.stepFrames(1);","  const es = harness.getObjects('Enemy');","  for (const e of es) {","    const key = e.id;","    if (key in prev) {","      const dx = e.centerX - prev[key].x, dy = e.centerY - prev[key].y;","      const spd = Math.hypot(dx, dy) * 60;","      if (spd > worst) { worst = spd; worstFrame = f; }","      if (spd > 250) spikes++;","      const zj = Math.abs(e.z - 52);","      if (zj > zJitter) zJitter = zj;","    }","    prev[key] = { x: e.centerX, y: e.centerY };","  }","}","console.log('[fix] worst enemy speed=' + worst.toFixed(0) + ' px/s at frame ' + worstFrame + ', spikes>250: ' + spikes + ', max Z deviation from 52: ' + zJitter.toFixed(2));","harness.assert(worst <= 250, 'No enemy zipping at launch: worst speed ' + worst.toFixed(0) + ' px/s <= 250');","harness.assert(zJitter < 2, 'Enemy Z stays near 52 at launch (deviation ' + zJitter.toFixed(2) + ')');",""]},{"description":"Enemy is knocked back when hit, then stops following until the hit animation ends.","lastRunAt":1787568325213.0,"lastRunDurationMs":1557.0,"lastRunFramesExecuted":63,"lastRunStatus":"passed","name":"Enemy knockback-on-hit and stop-following","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(10);","","const p = harness.getObjects('Player')[0];","// Spawn an enemy whose center lands ~70px east of the player (within hit range 125).","const e0 = harness.spawn('Enemy', p.centerX + 70 - 153.6 / 2, p.centerY - 153.6 / 2, 51);","await harness.stepFrames(3);","let e = harness.getObjects('Enemy').find(o => o.id === e0.id);","const cdx = e.centerX - p.centerX, cdy = e.centerY - p.centerY;","harness.assert(Math.hypot(cdx, cdy) < 125, 'Enemy within hit range');","","// Aim and hit the enemy.","harness.setMousePosition(p.centerX + 4 * cdx, p.centerY - 4 * cdy);","await harness.stepFrames(2);","harness.setMouseButtonPressed(true, 'left');","await harness.stepFrames(1);","harness.setMouseButtonPressed(false, 'left');","await harness.stepFrames(1);","e = harness.getObjects('Enemy').find(o => o.id === e0.id);","let knocked = (e.variables || []).find(v => (v.name || v.variableName) === 'Knocked');","let hit = (e.variables || []).find(v => (v.name || v.variableName) === 'Hit');","harness.assert(knocked.value === true && hit.value === true, 'Enemy knocked and hit');","","// Immediately after hit, the enemy should be pushed AWAY from the player (knockback).","const d0 = Math.hypot(e.centerX - p.centerX, e.centerY - p.centerY);","await harness.stepFrames(6);","e = harness.getObjects('Enemy').find(o => o.id === e0.id);","const d1 = Math.hypot(e.centerX - p.centerX, e.centerY - p.centerY);","harness.assert(d1 > d0 + 5, 'Knockback pushed enemy away (dist ' + d0.toFixed(1) + ' -> ' + d1.toFixed(1) + ')');","","// After knockback ends but while hit animation still plays, enemy must NOT follow.","let followedDuringAnim = false;","let stillHit = true;","for (let i = 0; i < 40; i++) {","  await harness.stepFrames(3);","  e = harness.getObjects('Enemy').find(o => o.id === e0.id);","  if (!e) break;","  hit = (e.variables || []).find(v => (v.name || v.variableName) === 'Hit');","  const mv = (e.variables || []).find(v => (v.name || v.variableName) === 'Moving');","  if (hit && hit.value === true && mv && mv.value === true) { followedDuringAnim = true; break; }","  if (hit && hit.value === false) { stillHit = false; break; }","}","harness.assert(!followedDuringAnim, 'Enemy does not follow player while hit animation plays');",""]},{"description":"When an enemy that is attacking gets hit by the player, its attack is cancelled immediately and cannot restart until the hit-stun ends.","lastRunAt":1787621210095.0,"lastRunDurationMs":2775.0,"lastRunFramesExecuted":332,"lastRunStatus":"passed","name":"Hit interrupts enemy attack","type":"gameplay","source":["await harness.goToScene('Game Scene');","","// Wait for an enemy to close in and start its attack","let attackerId = null;","const attacking = await harness.stepUntil(() => {","  for (const e of harness.getObjects('Enemy')) {","    if (harness.getObjectVariable(e.id, 'IsAttacking')?.value === true) {","      attackerId = e.id;","      return true;","    }","  }","  return false;","}, { maxFrames: 2400 });","harness.assert(attacking && attackerId !== null, 'An enemy started attacking the player');","","// Land a sprint hit on it (Space = sprint, event-29 hits enemies within 125px)","harness.setKeyPressed('Space', true);","let hitLanded = false;","const interrupted = await harness.stepUntil(() => {","  const target = harness.getObjects('Enemy').find(e => e.id === attackerId);","  if (!target) return false;","  if (harness.getObjectVariable(target.id, 'Hit')?.value === true) {","    hitLanded = true;","    return harness.getObjectVariable(target.id, 'IsAttacking')?.value === false;","  }","  return false;","}, { maxFrames: 300 });","harness.releaseAllInputs();","harness.assert(hitLanded, 'The attacking enemy was hit by the player');","harness.assert(interrupted, 'IsAttacking became false when the hit landed');","","// It must stay interrupted for the whole hit-stun (no attack while Hit is true)","for (let i = 0; i < 180; i++) {","  await harness.stepFrames(1);","  const t = harness.getObjects('Enemy').find(e => e.id === attackerId);","  if (!t) break; // enemy died","  const stillHit = harness.getObjectVariable(t.id, 'Hit')?.value === true;","  const attackingAgain = harness.getObjectVariable(t.id, 'IsAttacking')?.value === true;","  harness.assert(!attackingAgain || !stillHit, 'Enemy never attacks while in hit-stun');","  if (!stillHit) break;","}",""]},{"description":"Fix stored horizontal hit symmetry test timeout with minimal frame-step change.","lastRunAt":1787621302061.0,"lastRunDurationMs":1303.0,"lastRunFramesExecuted":22,"lastRunStatus":"failed","name":"Horizontal hit registration symmetry","type":"gameplay","source":["const Z = 52;","","async function trial(side) {","  await harness.goToScene('Game Scene');","  // Remove the level's own enemies and freeze spawning interference for a controlled setup","  for (const e of harness.getObjects('Enemy')) harness.removeObject(e.id);","  const player = harness.getObjects('Player')[0];","  const px = player.centerX, py = player.centerY;","","  // Enemy exactly 100px east or west of the player's center","  const enemy = harness.spawn('Enemy', side === 'east' ? px + 100 : px - 100, py, Z);","  harness.setObjectVariable(enemy.id, 'Speed', 0); // freeze it in place","","  // Aim the cursor well past the enemy (same side), then click","  harness.setMousePosition(side === 'east' ? px + 300 : px - 300, py);","  await harness.stepFrames(1); // let FacingAngle settle","  const facing = harness.getObjectVariable(player.id, 'FacingAngle')?.value;","  harness.setMouseButtonPressed(true, 'left');","  await harness.stepFrames(1);","  harness.setMouseButtonPressed(false, 'left');","","  let hitFrame = -1;","  for (let i = 0; i < 15; i++) {","    await harness.stepFrames(1);","    const e = harness.getObjects('Enemy').find(x => x.id === enemy.id);","    if (!e) { hitFrame = i; break; } // died from the hit","    if (harness.getObjectVariable(e.id, 'Hit')?.value === true) { hitFrame = i; break; }","  }","  return { side, facing, hitFrame,","           hit: hitFrame >= 0,","           enemyCount: harness.getObjects('Enemy').length };","}","","const east = await trial('east');","const west = await trial('west');","console.log('EAST:', JSON.stringify(east));","console.log('WEST:', JSON.stringify(west));","harness.assert(east.hit, 'Enemy due EAST (100px, cursor aimed at it) registers the hit');","harness.assert(west.hit, 'Enemy due WEST (100px, cursor aimed at it) registers the hit');","harness.assert(east.hit === west.hit, 'Hit registration is symmetric horizontally');",""]},{"description":"Diagnostics: how FacingAngle maps mouse positions under the third-person camera.","lastRunAt":1787620869729.0,"lastRunDurationMs":886.0,"lastRunFramesExecuted":5,"lastRunStatus":"passed","name":"FacingAngle cursor mapping diagnostic","type":"gameplay","source":["await harness.goToScene('Game Scene');","const player = harness.getObjects('Player')[0];","const px = player.centerX, py = player.centerY;","console.log('Player center:', px, py);","console.log('Camera state:', JSON.stringify(harness.getCameraState('')));","","harness.setMousePosition(px + 300, py);","await harness.stepFrames(1);","const east = {","  CursorX: harness.getObjects('Player').length ? undefined : undefined,","  facing: harness.getObjectVariable(player.id, 'FacingAngle')?.value,","};","// read cursor via a scene expression equivalent: use the player position recorded","console.log('EAST facing:', east.facing, '(expected ~90)');","","harness.setMousePosition(px - 300, py);","await harness.stepFrames(1);","console.log('WEST facing:', harness.getObjectVariable(player.id, 'FacingAngle')?.value, '(expected ~-90)');","","harness.setMousePosition(px, py + 300);","await harness.stepFrames(1);","console.log('SOUTH facing:', harness.getObjectVariable(player.id, 'FacingAngle')?.value, '(expected ~180/-180)');","","harness.setMousePosition(px, py - 300);","await harness.stepFrames(1);","console.log('NORTH facing:', harness.getObjectVariable(player.id, 'FacingAngle')?.value, '(expected ~0)');",""]},{"description":"Faithful reproduction: click the east/west enemy using actual screen-pixel aiming under the 3D camera.","lastRunAt":1787621031924.0,"lastRunDurationMs":1959.0,"lastRunFramesExecuted":216,"lastRunStatus":"failed","name":"Screen-pixel horizontal hit symmetry","type":"gameplay","source":["const Z = 52;","","async function setup(side) {","  await harness.goToScene('Game Scene');","  for (const e of harness.getObjects('Enemy')) harness.removeObject(e.id);","  const player = harness.getObjects('Player')[0];","  const px = player.centerX, py = player.centerY;","  const enemy = harness.spawn('Enemy', side==='east' ? px+100 : px-100, py, Z);","  harness.setObjectVariable(enemy.id, 'Speed', 0);","  return { enemy, px, py };","}","","async function findFacingScreen(side) {","  const { enemy } = await setup(side);","  const W = harness.getGameResolutionWidth(), H = harness.getGameResolutionHeight();","  const midX = W/2, midY = H/2;","  // scan screen X (and a little Y) to find where FacingAngle ~ +90 (east) / -90 (west)","  const dir = side==='east' ? 1 : -1;","  let found = null;","  for (let step = 0; step < W/2; step += 6) {","    const sx = midX + dir*step;","    harness.setMousePositionScreen(sx, midY);","    await harness.stepFrames(1);","    const f = harness.getObjectVariable(harness.getObjects('Player')[0].id, 'FacingAngle')?.value;","    if (f !== undefined && Math.abs(Math.abs(f) - 90) < 4) { found = {sx, sy: midY, f}; break; }","  }","  return { found, enemy, midX, midY };","}","","async function clickAndCheck(side) {","  const { found, enemy, midX, midY } = await findFacingScreen(side);","  let msg = side+' scanning: '+(found? JSON.stringify(found) : 'no screen pos gave +/-90');","  let ok = false;","  if (found) {","    harness.setMousePositionScreen(found.sx, found.sy);","    await harness.stepFrames(2);","    harness.setMouseButtonPressed(true, 'left');","    await harness.stepFrames(1);","    harness.setMouseButtonPressed(false, 'left');","    for (let i=0;i<15;i++){","      await harness.stepFrames(1);","      const e = harness.getObjects('Enemy').find(x=>x.id===enemy.id);","      if (!e || harness.getObjectVariable(e.id,'Hit')?.value===true){ ok=true; break; }","    }","  }","  console.log(msg, 'HIT=', ok);","  return ok;","}","","const e = await clickAndCheck('east');","const w = await clickAndCheck('west');","harness.assert(e, 'EAST screen-click registers the hit');","harness.assert(w, 'WEST screen-click registers the hit');","harness.assert(e === w, 'horizontal symmetry with real screen pixels');",""]},{"description":"Find the real screen pixel that makes FacingAngle = +90 / -90 and click there against an east / west enemy.","lastRunAt":1787621109213.0,"lastRunDurationMs":10160.0,"lastRunFramesExecuted":3439,"lastRunStatus":"failed","name":"Real-screen aim-pixel hit symmetry","type":"gameplay","source":["const Z = 52;","","async function findAimPixel(targetDeg) {","  const W = harness.getGameResolutionWidth(), H = harness.getGameResolutionHeight();","  for (let sy = 200; sy < H; sy += 12) {","    for (let sx = 80; sx < W; sx += 12) {","      harness.setMousePositionScreen(sx, sy);","      await harness.stepFrames(1);","      const f = harness.getObjectVariable(harness.getObjects('Player')[0].id, 'FacingAngle')?.value;","      if (f !== undefined && Math.abs(f - targetDeg) < 4) return { sx, sy, f };","    }","  }","  return null;","}","","async function trySide(targetDeg, side) {","  await harness.goToScene('Game Scene');","  for (const e of harness.getObjects('Enemy')) harness.removeObject(e.id);","  const player = harness.getObjects('Player')[0];","  const px = player.centerX, py = player.centerY;","  const enemy = harness.spawn('Enemy', side==='east' ? px+100 : px-100, py, Z);","  harness.setObjectVariable(enemy.id, 'Speed', 0);","  const p = await findAimPixel(targetDeg);","  let ok = false, record = p; ","  if (p) {","    harness.setMousePositionScreen(p.sx, p.sy);","    await harness.stepFrames(2);","    harness.setMouseButtonPressed(true, 'left');","    await harness.stepFrames(1);","    harness.setMouseButtonPressed(false, 'left');","    for (let i=0;i<15;i++){","      await harness.stepFrames(1);","      const e = harness.getObjects('Enemy').find(x=>x.id===enemy.id);","      if (!e || harness.getObjectVariable(e.id,'Hit')?.value===true){ ok=true; break; }","    }","  }","  console.log(side, 'aim pixel:', JSON.stringify(record), 'HIT=', ok);","  return ok;","}","","const e = await trySide(90, 'east');","const w = await trySide(-90, 'west');","harness.assert(e, 'EAST registers when game faces due east');","harness.assert(w, 'WEST registers when game faces due west');","harness.assert(e===w, 'horizontal symmetry using real screen aim pixels');",""]},{"description":"Stamina test","lastRunAt":1787654560086.0,"lastRunDurationMs":26762.0,"lastRunFramesExecuted":319,"lastRunStatus":"passed","name":"Stamina no-regen, empty gate and kill reward","type":"gameplay","source":["await harness.goToScene('Game Scene');","","// --- 1. Stamina does NOT recharge over time ---","harness.setObjectVariable('Player', 'Stamina', 10);","await harness.stepFrames(60);","const stamIdle = Number(harness.getObjectVariable('Player', 'Stamina')?.value);","harness.assert(Math.abs(stamIdle - 10) < 0.01, `Stamina unchanged when idle (got ${stamIdle}, expected 10)`);","","// --- 2. Sprint unusable when bar is empty ---","harness.setObjectVariable('Player', 'Stamina', 0);","harness.setKeyPressed('Space', true);","await harness.stepFrames(10);","const sprintingEmpty = harness.getObjectVariable('Player', 'IsSprinting')?.value === true;","harness.assert(!sprintingEmpty, 'IsSprinting stays false when Stamina is 0');","harness.setKeyPressed('Space', false);","await harness.stepFrames(2);","","// --- 3. Killing an enemy with a left-click attack grants +1 stamina ---","const player = () => harness.getObjects('Player')[0];","const p0 = player();","const enemy = harness.spawn('Enemy', p0.centerX + 100, p0.centerY);","harness.setObjectVariable('Player', 'Stamina', 5);","let died = false;","for (let i = 0; i < 15 && !died; i++) {","  const pl = player();","  // aim east of the player so FacingAngle points at the enemy","  harness.setMousePosition(pl.centerX + 300, pl.centerY, '');","  await harness.stepFrames(1);","  harness.setMouseButtonPressed(true, 'left');","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false, 'left');","  // wait for the attack to finish before clicking again","  await harness.stepUntil(() => {","    const pp = player();","    return !!pp && harness.getObjectVariable('Player', 'IsAttacking')?.value !== true;","  }, { maxFrames: 150 });","  const stillThere = harness.getObjects('Enemy').some(e => e.id === enemy.id);","  if (!stillThere) died = true;","}","harness.assert(died, 'Spawned enemy was killed by left-click attacks');","const stamAfterKill = Number(harness.getObjectVariable('Player', 'Stamina')?.value);","harness.assert(Math.abs(stamAfterKill - 6) < 0.01, `Stamina gained exactly +1 after the kill (got ${stamAfterKill}, expected 6)`);"]},{"description":"Player starts at 0 stamina; killing an enemy with a left-click attack briefly shows a '+ 1 Stamina' popup at the bottom of the screen that hides after ~1.5s.","lastRunAt":1787651706272.0,"lastRunDurationMs":1843.0,"lastRunFramesExecuted":303,"lastRunStatus":"passed","name":"Zero start stamina and +1 stamina popup","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(5);","","// --- Player starts with 0 stamina ---","const stamStart = Number(harness.getObjectVariable('Player', 'Stamina')?.value);","harness.assert(stamStart === 0, `Player starts with 0 stamina (got ${stamStart})`);","","// --- Popup hidden at start ---","let txt = harness.getObjects('StaminaGainText')[0];","harness.assert(!!txt && txt.hidden === true, 'Stamina gain popup is hidden at scene start');","","// --- Kill an enemy with left-click attacks ---","const p0 = harness.getObjects('Player')[0];","const enemy = harness.spawn('Enemy', p0.centerX + 100, p0.centerY);","let died = false;","for (let i = 0; i < 15 && !died; i++) {","  const pl = harness.getObjects('Player')[0];","  harness.setMousePosition(pl.centerX + 300, pl.centerY, '');","  await harness.stepFrames(1);","  harness.setMouseButtonPressed(true, 'left');","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false, 'left');","  await harness.stepUntil(() => {","    const pp = harness.getObjects('Player')[0];","    return !!pp && harness.getObjectVariable('Player', 'IsAttacking')?.value !== true;","  }, { maxFrames: 150 });","  if (!harness.getObjects('Enemy').some(e => e.id === enemy.id)) died = true;","}","harness.assert(died, 'Spawned enemy was killed by left-click attacks');","","// --- Popup briefly shows \"+ 1 Stamina\" ---","txt = harness.getObjects('StaminaGainText')[0];","harness.assert(!!txt && txt.hidden === false, 'Popup becomes visible on kill');","harness.assert(txt.text === '+ 1 Stamina', `Popup text is \"+ 1 Stamina\" (got \"${txt.text}\")`);","const stamAfterKill = Number(harness.getObjectVariable('Player', 'Stamina')?.value);","harness.assert(stamAfterKill === 1, `Stamina went from 0 to 1 after the kill (got ${stamAfterKill})`);","","// --- Popup hides again after ~1.5s ---","const hidAgain = await harness.stepUntil(() => {","  const t = harness.getObjects('StaminaGainText')[0];","  return !!t && t.hidden === true;","}, { maxFrames: 180 });","harness.assert(hidAgain, 'Popup hides again after about 1.5 seconds');"]},{"description":"Enemies get slightly different speeds (SpeedMult 0.9-1.1); off-camera enemies follow only on a 50% roll, while on-camera enemies always follow.","lastRunAt":1787652766804.0,"lastRunDurationMs":1327.0,"lastRunFramesExecuted":161,"lastRunStatus":"passed","name":"Enemy speed variation and offscreen chase chance","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(10);","","// --- 1. Each enemy gets its own slightly different speed multiplier ---","const enemies = harness.getObjects('Enemy');","const mults = enemies.map(e => Number(harness.getObjectVariable(e.id, 'SpeedMult')?.value));","harness.assert(enemies.length >= 3, `Phase 1 spawned at least 3 enemies (got ${enemies.length})`);","harness.assert(mults.every(m => m >= 0.89 && m <= 1.11), `All SpeedMult within 0.9-1.1 (got ${mults.join(', ')})`);","harness.assert(new Set(mults).size > 1, `SpeedMults differ between enemies (got ${mults.join(', ')})`);","","// --- 2. Off-camera enemy with roll 0 does NOT follow ---","const cam = harness.getCameraState('');","const p = harness.getObjects('Player')[0];","const offX = Math.max(cam.x + 640 + 260, p.centerX + 900); // safely outside the camera view","const lazy = harness.spawn('Enemy', offX, cam.y);","harness.setObjectVariable(lazy.id, 'OffscreenChase', 0);","const lx = lazy.x, ly = lazy.y;","await harness.stepFrames(90);","const lazyNow = harness.getObjects('Enemy').find(e => e.id === lazy.id);","const movedLazy = Math.hypot(lazyNow.x - lx, lazyNow.y - ly);","harness.assert(movedLazy < 10, `Off-camera enemy with roll 0 stays put (moved ${movedLazy.toFixed(1)}px)`);","","// --- 3. Same off-camera enemy with roll 1 DOES follow ---","harness.setObjectVariable(lazy.id, 'OffscreenChase', 1);","const lx2 = lazyNow.x, ly2 = lazyNow.y;","await harness.stepFrames(60);","const loyalNow = harness.getObjects('Enemy').find(e => e.id === lazy.id);","const movedLoyal = Math.hypot(loyalNow.x - lx2, loyalNow.y - ly2);","harness.assert(movedLoyal > 25, `Off-camera enemy with roll 1 chases the player (moved ${movedLoyal.toFixed(1)}px)`);","","// --- 4. On-camera enemy ALWAYS follows, even with roll 0 ---","const p2 = harness.getObjects('Player')[0];"]},{"description":"Verify enemy physics hitbox is 0.6x in X and 0.8x in Y","lastRunAt":1787654489412.0,"lastRunDurationMs":0.0,"lastRunFramesExecuted":0,"lastRunStatus":"error","name":"Enemy anisotropic hitbox verify","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(8);","const pb = harness.getRuntimeObject('Enemy').getBehavior('Physics3D');","const W = pb._shapeHalfWidth, H = pb._shapeHalfHeight, D = pb._shapeHalfDepth;","console.log('halfW=' + W + ' halfH=' + H + ' halfD=' + D);","// Baseline (old, uniform 0.3 scale): halfW_old = 512*0.3*0.5/2 = 38.4, halfH_old = 512*0.3*0.5/2 = 38.4","const oldW = 38.4, oldH = 38.4;","const ratioX = W / oldW;","const ratioY = H / oldH;","console.log('ratioX=' + ratioX.toFixed(3) + ' ratioY=' + ratioY.toFixed(3));","harness.assert(Math.abs(ratioX - 0.6) < 0.02, `Physics half-width is ~0.6x (got ${ratioX.toFixed(3)})`);","harness.assert(Math.abs(ratioY - 0.8) < 0.02, `Physics half-height is ~0.8x (got ${ratioY.toFixed(3)})`);"]},{"description":"Enemy physics hitbox is 0.6x horizontally and 0.8x vertically (north-south).","lastRunAt":1787654618666.0,"lastRunDurationMs":18340.0,"lastRunFramesExecuted":9,"lastRunStatus":"passed","name":"Enemy hitbox 0.6x horizontal 0.8x vertical","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(8);","const pb = harness.getRuntimeObject('Enemy').getBehavior('Physics3D');","const W = pb._shapeHalfWidth, H = pb._shapeHalfHeight;","// Old (uniform 0.3 scale, ShapeScale 0.5) box: halfW = halfH = 0.768 (physics world units)","const oldW = 0.768, oldH = 0.768;","const ratioX = W / oldW, ratioY = H / oldH;","console.log('halfW=' + W + ' halfH=' + H + ' ratioX=' + ratioX.toFixed(3) + ' ratioY=' + ratioY.toFixed(3));","harness.assert(Math.abs(ratioX - 0.6) < 0.02, `Physics hitbox is 0.6x in X (horizontal): got ${ratioX.toFixed(3)}`);","harness.assert(Math.abs(ratioY - 0.8) < 0.02, `Physics hitbox is 0.8x in Y (north-south): got ${ratioY.toFixed(3)}`);"]},{"description":"Enemy sprite full size, one hidden EnemyHitbox per enemy centered on it, and combat still works via the hitbox.","lastRunAt":1787655508776.0,"lastRunDurationMs":25606.0,"lastRunFramesExecuted":636,"lastRunStatus":"failed","name":"Enemy hitbox separate + full sprite + combat","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(20);","","// 1. Enemy sprite is full size (scale 0.3, footprint ~153.6) — not shrunk by 0.6/0.8","const en = harness.getObjects('Enemy')[0];","harness.assert(!!en, 'Enemy spawned');","console.log('Enemy width=' + en.width + ' height=' + en.height);","harness.assert(Math.abs(en.width - 153.6) < 8, `Enemy sprite is full size (got width ${en.width.toFixed(1)})`);","","// 2. One hidden EnemyHitbox per enemy, following its enemy","const enemies = harness.getObjects('Enemy');","const hb = harness.getObjects('EnemyHitbox');","harness.assert(hb.length === enemies.length, `One hitbox per enemy (${hb.length} hitboxes, ${enemies.length} enemies)`);","hb.forEach(b => harness.assert(b.hidden === true, 'EnemyHitbox is invisible'));","","// check a hitbox is centered on its enemy","const e0 = en;","const h0 = hb[0];","const dx = Math.abs(h0.centerX - e0.centerX);","const dy = Math.abs(h0.centerY - e0.centerY);","console.log('hitbox center dx=' + dx.toFixed(1) + ' dy=' + dy.toFixed(1));","harness.assert(dx < 5 && dy < 5, `Hitbox is centered on enemy (dx=${dx.toFixed(1)}, dy=${dy.toFixed(1)})`);","","// 3. Combat still works: kill an enemy with left-click attacks (via hitbox)","const p0 = harness.getObjects('Player')[0];","const target = harness.spawn('Enemy', p0.centerX + 100, p0.centerY);","// spawn a linked hitbox for the test enemy too","const thb = harness.spawn('EnemyHitbox', p0.centerX + 100, p0.centerY);","// (sync event will position it; link not set but PickObjectsLinkedTo needs it —","//  instead rely on the phase-spawned enemies for combat test)","let killed = false;","for (let i = 0; i < 15 && !killed; i++) {","  const pl = harness.getObjects('Player')[0];","  harness.setMousePosition(pl.centerX + 300, pl.centerY, '');","  await harness.stepFrames(1);","  harness.setMouseButtonPressed(true, 'left');","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false, 'left');","  await harness.stepUntil(() => {","    const pp = harness.getObjects('Player')[0];","    return !!pp && harness.getObjectVariable('Player', 'IsAttacking')?.value !== true;","  }, { maxFrames: 150 });","  if (!harness.getObjects('Enemy').some(e => e.id === target.id)) killed = true;","}","harness.assert(killed, 'Player can still kill an enemy (combat works via hitbox)');"]},{"description":"Enemy sprite full size, one hidden centered EnemyHitbox per enemy, combat works via hitbox, and hitbox removed with enemy death.","lastRunAt":1787655541349.0,"lastRunDurationMs":12306.0,"lastRunFramesExecuted":515,"lastRunStatus":"passed","name":"Enemy hitbox full-sprite combat and cleanup","type":"gameplay","source":["await harness.goToScene('Game Scene');","await harness.stepFrames(20);","","// 1. Enemy sprite is full size","const en = harness.getObjects('Enemy')[0];","harness.assert(!!en, 'Enemy spawned');","harness.assert(Math.abs(en.width - 153.6) < 8, `Enemy sprite is full size (got width ${en.width.toFixed(1)})`);","","// 2. One hidden EnemyHitbox per enemy, centered on it","const enemies = harness.getObjects('Enemy');","const hb = harness.getObjects('EnemyHitbox');","harness.assert(hb.length === enemies.length, `One hitbox per enemy (${hb.length} hitboxes, ${enemies.length} enemies)`);","hb.forEach(b => harness.assert(b.hidden === true, 'EnemyHitbox is invisible'));","const h0 = hb[0];","harness.assert(Math.abs(h0.centerX - en.centerX) < 5 && Math.abs(h0.centerY - en.centerY) < 5, 'Hitbox is centered on enemy');","","// 3. Combat works: kill a phase-spawned (linked) enemy with left-click attacks","const p0 = harness.getObjects('Player')[0];","const targetId = enemies[0].id;","let killed = false;","for (let i = 0; i < 20 && !killed; i++) {","  const pl = harness.getObjects('Player')[0];","  harness.setMousePosition(pl.centerX + 300, pl.centerY, '');","  await harness.stepFrames(1);","  harness.setMouseButtonPressed(true, 'left');","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false, 'left');","  await harness.stepUntil(() => {","    const pp = harness.getObjects('Player')[0];","    return !!pp && harness.getObjectVariable('Player', 'IsAttacking')?.value !== true;","  }, { maxFrames: 150 });","  if (!harness.getObjects('Enemy').some(e => e.id === targetId)) killed = true;","}","harness.assert(killed, 'Player can still kill a phase enemy via the hitbox');","// 4. Hitbox removed with the enemy","await harness.stepFrames(2);","const hbLeft = harness.getObjects('EnemyHitbox');","const enLeft = harness.getObjects('Enemy');","harness.assert(hbLeft.length === enLeft.length, `Hitbox count matches enemy count after death (${hbLeft.length} vs ${enLeft.length})`);"]},{"description":"Spawn an enemy and verify its linked EnemyHitbox width is 64.4 (30% smaller than 92).","lastRunAt":1787694306433.0,"lastRunDurationMs":7249.0,"lastRunFramesExecuted":6,"lastRunStatus":"passed","name":"Enemy hitbox 30% narrower horizontal","type":"gameplay","source":["await harness.goToScene('Game Scene');","// Force a phase spawn so an enemy + hitbox are created.","harness.setSceneVariable('PhaseSpawning', true);","harness.setSceneVariable('count', 1);","harness.setSceneVariable('spawnX', 400);","harness.setSceneVariable('spawnY', 300);","await harness.stepFrames(5);","const enemies = harness.getObjects('Enemy');","harness.assert(enemies.length >= 1, 'At least one enemy spawned');","const hitboxes = harness.getObjects('EnemyHitbox');","harness.assert(hitboxes.length >= 1, 'At least one EnemyHitbox spawned');","const hb = hitboxes[0];","harness.assert(Math.abs(hb.width - 64.4) < 0.5, 'EnemyHitbox width is ~64.4 (30% narrower), got ' + hb.width);","harness.assert(Math.abs(hb.height - 124.5) < 0.5, 'EnemyHitbox height unchanged at 124.5, got ' + hb.height);"]}],"eventsFunctionsExtensions":[{"author":"","category":"Input","dimension":"","extensionNamespace":"","fullName":"3D character keyboard mapper","gdevelopVersion":">=5.5.222","helpPath":"","iconUrl":"data:image/svg+xml;base64,","name":"PhysicsCharacter3DKeyMapper","previewIconUrl":"https://asset-resources.gdevelop.io/public-resources/Icons/Glyphster Pack/Master/SVG/Computers and Hardware/3e5871434a72821bf3ecb44a6857e62a438cf23dc8f95966f56ae97e95315468_Computers and Hardware_keyboard.svg","shortDescription":"3D platformer and 3D shooter keyboard controls.","version":"1.1.1","description":"3D platformer and 3D shooter keyboard controls.","origin":{"identifier":"PhysicsCharacter3DKeyMapper","name":"gdevelop-extension-store"},"tags":["3d"],"a